APP_ENV=prod
APP_SECRET={{ museumplus_oai_adapter.app_secret | to_json }}
DEFAULT_URI={{ ('https://' ~ museumplus_oai_adapter.nginx.server_name) | to_json }}

DATABASE_URL="mysql://{{ museumplus_oai_adapter.mysql.username | urlencode }}:{{ museumplus_oai_adapter.mysql.password | urlencode }}@{{ museumplus_oai_adapter.mysql.hostname }}:{{ museumplus_oai_adapter.mysql.port }}/{{ museumplus_oai_adapter.mysql.database }}?serverVersion={{ museumplus_oai_adapter.mysql.server_version | default(mariadb_version ~ '-MariaDB') | urlencode }}&charset=utf8mb4"

MUSEUMPLUS_EXPORT_URL={{ museumplus_oai_adapter.museumplus.export_url | to_json }}
MUSEUMPLUS_USERNAME={{ museumplus_oai_adapter.museumplus.username | to_json }}
MUSEUMPLUS_PASSWORD={{ museumplus_oai_adapter.museumplus.password | to_json }}
MUSEUMPLUS_SEARCH_FIELD_PATH={{ museumplus_oai_adapter.museumplus.search_field_path | to_json }}
MUSEUMPLUS_SEARCH_OPERAND={{ museumplus_oai_adapter.museumplus.search_operand | to_json }}
MUSEUMPLUS_OAI_IDENTIFIER_PREFIX={{ museumplus_oai_adapter.oai.identifier_prefix | to_json }}
MUSEUMPLUS_DEFAULT_SET_SPEC={{ museumplus_oai_adapter.oai.default_set_spec | to_json }}
MUSEUMPLUS_TIMEOUT_SECONDS={{ museumplus_oai_adapter.museumplus.timeout_seconds }}
