# Managed by Ansible. Change host_vars/Vault, not the generated file.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET={{ museumplus_oai_adapter.app_secret | string | to_json(ensure_ascii=false) | replace('$', '\\$') }}

{% set db = museumplus_oai_adapter.mysql %}
DATABASE_URL="mysql://{{ db.username | urlencode | replace('/', '%2F') }}:{{ db.password | urlencode | replace('/', '%2F') }}@{{ db.hostname }}:{{ db.port }}/{{ db.database | urlencode | replace('/', '%2F') }}?serverVersion={{ (mariadb_version ~ '-MariaDB') | urlencode }}&charset=utf8mb4"

MUSEUMPLUS_EXPORT_URL={{ museumplus_oai_adapter.museumplus.export_url | string | to_json(ensure_ascii=false) | replace('$', '\\$') }}
MUSEUMPLUS_USERNAME={{ museumplus_oai_adapter.museumplus.username | string | to_json(ensure_ascii=false) | replace('$', '\\$') }}
MUSEUMPLUS_PASSWORD={{ museumplus_oai_adapter.museumplus.password | string | to_json(ensure_ascii=false) | replace('$', '\\$') }}
MUSEUMPLUS_WEBPUBLICATION_IDS={{ museumplus_oai_adapter.museumplus.webpublication_ids | join(',') | to_json(ensure_ascii=false) | replace('$', '\\$') }}
MUSEUMPLUS_TIMEOUT_SECONDS={{ museumplus_oai_adapter.museumplus.timeout_seconds | string | to_json(ensure_ascii=false) | replace('$', '\\$') }}
MUSEUMPLUS_OAI_IDENTIFIER_PREFIX={{ museumplus_oai_adapter.oai.identifier_prefix | string | to_json(ensure_ascii=false) | replace('$', '\\$') }}
MUSEUMPLUS_DEFAULT_SET_SPEC={{ museumplus_oai_adapter.oai.default_set_spec | string | to_json(ensure_ascii=false) | replace('$', '\\$') }}
