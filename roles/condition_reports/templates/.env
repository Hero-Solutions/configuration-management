# In all environments, the following files are loaded if they exist,
# the later taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices/configuration.html#infrastructure-related-configuration

###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET={{ condition_reports.app_secret }}
APP_SHARE_DIR=var/share
#TRUSTED_PROXIES=127.0.0.1,127.0.0.2
#TRUSTED_HOSTS='^localhost|example\.com$'
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# For an SQLite database, use: "sqlite:///%kernel.project_dir%/var/data.db"
# Configure your db driver and server_version in config/packages/doctrine.yaml
DATABASE_URL="mysql://{{ condition_reports.mysql.username }}:{{ condition_reports.mysql.password }}@{{ condition_reports.mysql.hostname }}:{{ condition_reports.mysql.port }}/{{ condition_reports.mysql.database }}?charset=utf8mb4"
###< doctrine/doctrine-bundle ###

DEFAULT_URI="https://{{ condition_reports.nginx.server_name }}"
SESSION_LIFETIME={{ condition_reports.session_lifetime | default(28800) }}

###> symfony/mailer ###
MAILER_DSN={{ condition_reports.mailer_dsn }}
###< symfony/mailer ###

MAIL_FROM="{{ condition_reports.mail_from | default(condition_reports.admin.email) }}"
FEEDBACK_EMAIL="{{ condition_reports.feedback_email | default(condition_reports.admin.email) }}"
DATAHUB_URL="{{ condition_reports.datahub_url }}"
IMAGE_DOWNLOAD_CA_FILE=""

###> Microsoft Entra SSO ###
{% set condition_reports_sso = condition_reports.sso | default({}) %}
SSO_ENABLED={{ (condition_reports_sso.enabled | default(false)) | ternary('1', '0') }}
SSO_ENTRA_TENANT_ID={{ condition_reports_sso.tenant_id | default('') | to_json }}
SSO_ENTRA_CLIENT_ID={{ condition_reports_sso.client_id | default('') | to_json }}
SSO_ENTRA_CLIENT_SECRET={{ condition_reports_sso.client_secret | default('') | to_json }}
SSO_ENTRA_ROLE_USER={{ condition_reports_sso.role_user | default('ConditionReports.User') | to_json }}
SSO_ENTRA_ROLE_READ_ONLY={{ condition_reports_sso.role_read_only | default('ConditionReports.ReadOnly') | to_json }}
SSO_ENTRA_ROLE_ADMIN={{ condition_reports_sso.role_admin | default('ConditionReports.Admin') | to_json }}
###< Microsoft Entra SSO ###
